    private void setupRecyclerViews(View view) {
        RecyclerView rvCart = view.findViewById(R.id.rvCartHorizontal);
        cartAdapter = new CartHorizontalAdapter();
        rvCart.setLayoutManager(new LinearLayoutManager(getContext()));
        rvCart.setAdapter(cartAdapter);

        RecyclerView rvResults = view.findViewById(R.id.rvSearchResults);
        searchAdapter = new SearchResultAdapter();
        rvResults.setLayoutManager(new LinearLayoutManager(getContext()));
        rvResults.setAdapter(searchAdapter);
    }

    private void setupObservers() {
        viewModel = new ViewModelProvider(this).get(SalesViewModel.class);
        viewModel.getProducts().observe(getViewLifecycleOwner(), products -> this.allProducts = products);
        viewModel.getCustomers().observe(getViewLifecycleOwner(), customers -> {
            if (customers != null) {
                this.allCustomers.clear();
                this.allCustomers.addAll(customers);
            }
        });
    }

    private void loadCurrencySettings() {
        if (getContext() != null) {
            SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(getContext());
            currencySymbol = prefs.getString("currency", "ر.س");
        }
    }

    /**
     * إنشاء رقم فاتورة تسلسلي مع التحقق من Firebase
     */
    private void generateNextInvoiceNumber(InvoiceNumberCallback callback) {
        Executors.newSingleThreadExecutor().execute(() -> {
            try {
                // أولاً: جلب آخر رقم من قاعدة البيانات المحلية
                int lastLocalNumber = getLastLocalInvoiceNumber();
                
                // ثانياً: التحقق من Firebase
                DatabaseReference invoiceRef = firebaseRef.child("app_data").child("invoices");
                DatabaseReference counterRef = firebaseRef.child("app_data").child("invoice_counter");
                
                // استخدام CountDownLatch للانتظار حتى اكتمال عملية Firebase
                CountDownLatch latch = new CountDownLatch(1);
                final int[] firebaseMaxNumber = {lastLocalNumber};
                
                // جلب جميع أرقام الفواتير من Firebase للتحقق
                final int finalLastLocalNumber = lastLocalNumber;
                invoiceRef.addListenerForSingleValueEvent(new ValueEventListener() {
                    @Override
                    public void onDataChange(@NonNull DataSnapshot snapshot) {
                        final int[] maxNumber = {finalLastLocalNumber};
                        
                        if (snapshot.exists()) {
                            for (DataSnapshot invoiceSnap : snapshot.getChildren()) {
                                String invoiceNumber = invoiceSnap.child("invoiceNumber").getValue(String.class);
                                if (invoiceNumber != null && invoiceNumber.startsWith("INV-")) {
                                    try {
                                        int num = Integer.parseInt(invoiceNumber.substring(4));
                                        if (num > maxNumber[0]) {
                                            maxNumber[0] = num;
                                        }
                                    } catch (NumberFormatException e) {
                                        // تجاهل الأرقام غير الصالحة
                                    }
                                }
                            }
                        }
                        
                        // أيضاً التحقق من عداد الفواتير
                        counterRef.addListenerForSingleValueEvent(new ValueEventListener() {
                            @Override
                            public void onDataChange(@NonNull DataSnapshot counterSnapshot) {
                                Integer counterValue = counterSnapshot.getValue(Integer.class);
                                if (counterValue != null && counterValue > maxNumber[0]) {
                                    maxNumber[0] = counterValue;
                                }
                                
                                firebaseMaxNumber[0] = maxNumber[0];
                                latch.countDown();
                            }

                            @Override
                            public void onCancelled(@NonNull DatabaseError error) {
                                latch.countDown();
                            }
                        });
                    }

                    @Override
                    public void onCancelled(@NonNull DatabaseError error) {
                        latch.countDown();
                    }
                });
                
                // انتظار حتى 10 ثوانٍ كحد أقصى
                latch.await(10, TimeUnit.SECONDS);
                
                // إنشاء الرقم الجديد
                int nextNumber = firebaseMaxNumber[0] + 1;
                String newInvoiceNumber = "INV-" + nextNumber;
                
                // تحديث العداد في Firebase
                counterRef.setValue(nextNumber);
                
                // تحديث العداد محلياً
                updateLocalCounter(nextNumber);
                
                // إرجاع النتيجة
                if (getActivity() != null) {
                    getActivity().runOnUiThread(() -> callback.onNumberGenerated(newInvoiceNumber));
                }
                
            } catch (Exception e) {
                Log.e(TAG, "خطأ في إنشاء رقم الفاتورة", e);
                // في حالة الخطأ، استخدم التوقيت كرقم احتياطي
                String fallbackNumber = "INV-" + (System.currentTimeMillis() / 1000);
                if (getActivity() != null) {
                    getActivity().runOnUiThread(() -> callback.onNumberGenerated(fallbackNumber));
                }
            }
        });
    }
    
    private int getLastLocalInvoiceNumber() {
        int maxNumber = 0;
        try {
            AppDatabase db = AppDatabase.getInstance(getContext());
            List<Invoice> invoices = db.invoiceDao().getAllSync();
            if (invoices != null) {
                for (Invoice inv : invoices) {
                    String num = inv.getInvoiceNumber();
                    if (num != null && num.startsWith("INV-")) {
                        try {
                            int n = Integer.parseInt(num.substring(4));
                            if (n > maxNumber) maxNumber = n;
                        } catch (NumberFormatException e) {
                            // تجاهل
                        }
                    }
                }
            }
        } catch (Exception e) {
            Log.e(TAG, "خطأ في جلب آخر رقم فاتورة محلي", e);
        }
        return maxNumber;
    }
    
    private void updateLocalCounter(int counter) {
        // يمكن تخزين العداد في SharedPreferences
        if (getContext() != null) {
            SharedPreferences prefs = getContext().getSharedPreferences("invoice_counter", android.content.Context.MODE_PRIVATE);
            prefs.edit().putInt("last_invoice_number", counter).apply();
        }
    }
    
    interface InvoiceNumberCallback {
